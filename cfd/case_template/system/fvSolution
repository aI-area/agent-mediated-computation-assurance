FoamFile
{
    version     2.0;
    format      ascii;
    class       dictionary;
    object      fvSolution;
}

solvers
{
    p               { solver GAMG; smoother GaussSeidel; tolerance 1e-12; relTol 0.01; }
    "(U|k|omega)"   { solver smoothSolver; smoother symGaussSeidel; tolerance 1e-14; relTol 0.05; }
}
SIMPLE
{
    consistent      yes;
    nNonOrthogonalCorrectors 0;
    residualControl { p 1e-12; U 1e-12; "(k|omega)" 1e-12; }  // effectively off: QoI rule in PREREGISTRATION.md decides
}
relaxationFactors
{
    equations { U 0.9; k 0.7; omega 0.7; }
    fields    { p 1.0; }
}
