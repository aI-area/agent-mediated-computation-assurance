FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

#include "../caseParameters"
dimensions      [0 2 -2 0 0 0 0];
internalField   uniform $kInf;
boundaryField
{
    airfoil      { type fixedValue; value uniform 1e-15; }
    farfield     { type inletOutlet; inletValue uniform $kInf; value uniform $kInf; }
    frontAndBack { type empty; }
}
