FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      omega;
}

#include "../caseParameters"
dimensions      [0 0 -1 0 0 0 0];
internalField   uniform $omegaInf;
boundaryField
{
    // y+ < 1 on the TMR grids: omegaWallFunction returns the viscous-sublayer value
    airfoil      { type omegaWallFunction; value uniform $omegaInf; }
    farfield     { type inletOutlet; inletValue uniform $omegaInf; value uniform $omegaInf; }
    frontAndBack { type empty; }
}
